# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# Debate workspace: keep sources, docs, fixtures and bench designs; drop renders and run results
design/**/out/
design/**/out_*/
design/**/r2_out/
design/**/results/
design/**/sheets/
design/**/r2_kit/
design/**/__pycache__/
design/debate/bench/results/
design/debate/bench/sheets/
design/debate/spikes/**/*.png
design/debate/bench/**/*.png
!design/debate/bench/assets/**/*.png
!design/debate/bench/designs/**/*.png
design/debate/proto/out/
design/debate/proto/fixtures/out/
